{
  "name": "dsh-plugin-weather",
  "version": "1.0.0",
  "private": true,
  "description": "Weather panel for DeepSeek Harness: city search, favourites, current conditions, hourly and 7-day forecast, and life indices.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "client",
    "lib",
    "src",
    "tools",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node tools/build-client.mjs",
    "test": "node tools/test.mjs && node tools/test-host.mjs",
    "check:manifest": "node tools/check-manifest.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panxueyao/dsh-plugin-weather.git"
  },
  "homepage": "https://github.com/panxueyao/dsh-plugin-weather",
  "bugs": {
    "url": "https://github.com/panxueyao/dsh-plugin-weather/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "weather",
    "open-meteo",
    "panel"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}
